{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sf",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "exclude": [".git", ".wrangler", ".github", "cf-worker", "CLAUDE.md", ".gitignore", "wrangler.jsonc"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
